# Build output. The binary is built by `make build` and is never committed.
bin/
dist/
*.exe
*.dll
*.so
*.dylib
*.a
*.o

# Test binaries and coverage. Both are regenerated by `make test` and
# `make cover`; coverage.out alone is ~10MB of per-statement counters.
*.test
*.out
coverage/
coverage.html

# Fuzzing corpora that a fuzzer wrote but that were not committed are reported
# by CI as a failure, so a local run's scratch corpus must not be committed
# either. The seeds under internal/*/testdata/fuzz are committed deliberately
# and are not affected by this rule.
/fuzz/

# Editor and OS noise.
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Local environment and secrets. NetForge needs none, and a repository has no
# business carrying one.
.env
.env.*
*.pem
*.key

# Module and build caches, in case a tool ever points one at the tree.
vendor/
go.work
go.work.sum
